// =============================================================================
//  PRACTITIONERS (doctors, dentists, midwives …)
//  PH prescriptions/certificates must show: PRC Lic. No., PTR No., S2 No. (if
//  prescribing dangerous drugs). PhilHealth PAN needed for PF claims.
// =============================================================================

enum PractitionerType {
  PHYSICIAN
  DENTIST
  MIDWIFE
  NURSE
  PSYCHOLOGIST
  PHYSICAL_THERAPIST
  NUTRITIONIST_DIETITIAN
  OPTOMETRIST
  OTHER

  @@map("practitioner_type")
}

model Practitioner {
  id           String           @id @default(uuid(7)) @db.Uuid
  userId       String?          @unique @map("user_id") @db.Uuid
  type         PractitionerType @default(PHYSICIAN)
  title        String? // "Dr.", "Dra."
  firstName    String           @map("first_name")
  middleName   String?          @map("middle_name")
  lastName     String           @map("last_name")
  suffix       String? // Jr., III
  postNominals String?          @map("post_nominals") // "MD, FPCP"
  sex          Sex?
  specialty    String? // Internal Medicine, Pediatrics, OB-GYN, Family Medicine …
  subspecialty String?
  mobileNo     String?          @map("mobile_no")
  email        String?

  // Professional credentials
  prcLicenseNo        String    @unique @map("prc_license_no")
  prcLicenseExpiry    DateTime? @map("prc_license_expiry") @db.Date
  ptrNo               String?   @map("ptr_no") // Professional Tax Receipt (renewed yearly)
  ptrIssuedDate       DateTime? @map("ptr_issued_date") @db.Date
  ptrIssuedAt         String?   @map("ptr_issued_at") // LGU where PTR was issued
  s2LicenseNo         String?   @map("s2_license_no") // PDEA S2 — required to prescribe dangerous drugs
  s2LicenseExpiry     DateTime? @map("s2_license_expiry") @db.Date
  philhealthPan       String?   @map("philhealth_pan") // PhilHealth Accreditation Number
  philhealthPanExpiry DateTime? @map("philhealth_pan_expiry") @db.Date
  tin                 String? // for EWT on professional fees
  signatureUrl        String?   @map("signature_url") // e-signature image for Rx / med cert

  defaultConsultFee Decimal?  @map("default_consult_fee") @db.Decimal(12, 2)
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id])

  branches            PractitionerBranch[]
  schedules           PractitionerSchedule[]
  leaves              PractitionerLeave[]
  appointments        Appointment[]
  queueTickets        QueueTicket[]
  encounters          Encounter[]
  proceduresPerformed EncounterProcedure[]
  diagnosticOrders    DiagnosticOrder[]
  resultsSigned       DiagnosticResult[]
  prescriptions       Prescription[]
  immunizations       Immunization[]
  medicalCertificates MedicalCertificate[]
  referralsMade       Referral[]             @relation("ReferralFrom")
  referralsReceived   Referral[]             @relation("ReferralTo")
  invoiceLines        InvoiceLine[]
  professionalFees    ProfessionalFee[]

  @@index([lastName, firstName])
  @@map("practitioners")
}

/// Which branches a doctor holds clinic in, with branch-specific fee/room
model PractitionerBranch {
  practitionerId String   @map("practitioner_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  roomName       String?  @map("room_name") // "Room 203"
  consultFee     Decimal? @map("consult_fee") @db.Decimal(12, 2)
  isActive       Boolean  @default(true) @map("is_active")

  practitioner Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([practitionerId, branchId])
  @@map("practitioner_branches")
}

/// Weekly clinic hours, e.g. MWF 9:00–12:00. dayOfWeek: 0=Sun … 6=Sat
model PractitionerSchedule {
  id             String   @id @default(uuid(7)) @db.Uuid
  practitionerId String   @map("practitioner_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  dayOfWeek      Int      @map("day_of_week")
  startTime      DateTime @map("start_time") @db.Time(0)
  endTime        DateTime @map("end_time") @db.Time(0)
  slotMinutes    Int      @default(15) @map("slot_minutes")
  maxPatients    Int?     @map("max_patients") // cap per session (common for "first come, first served" clinics)
  isActive       Boolean  @default(true) @map("is_active")

  practitioner Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([practitionerId, dayOfWeek])
  @@map("practitioner_schedules")
}

model PractitionerLeave {
  id             String   @id @default(uuid(7)) @db.Uuid
  practitionerId String   @map("practitioner_id") @db.Uuid
  startAt        DateTime @map("start_at") @db.Timestamptz(3)
  endAt          DateTime @map("end_at") @db.Timestamptz(3)
  reason         String? // conference, holiday, sick

  practitioner Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@index([practitionerId, startAt])
  @@map("practitioner_leaves")
}
