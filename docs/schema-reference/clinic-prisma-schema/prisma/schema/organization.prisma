// =============================================================================
//  ORGANIZATION, BRANCHES, USERS
// =============================================================================

enum VatRegistration {
  VAT
  NON_VAT

  @@map("vat_registration")
}

enum StaffRole {
  SUPER_ADMIN
  ADMIN
  DOCTOR
  NURSE
  MIDWIFE
  RECEPTIONIST
  CASHIER
  BILLING_CLERK
  PHARMACIST
  PHARMACY_ASSISTANT
  MEDTECH
  RADTECH
  INVENTORY_CLERK

  @@map("staff_role")
}

model Organization {
  id              String          @id @default(uuid(7)) @db.Uuid
  name            String // registered business name (DTI/SEC)
  tradeName       String?         @map("trade_name")
  tin             String? // BIR TIN, e.g. 123-456-789-000
  vatRegistration VatRegistration @default(NON_VAT) @map("vat_registration")
  secOrDtiNo      String?         @map("sec_or_dti_no")
  logoUrl         String?         @map("logo_url")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  branches          Branch[]
  patients          Patient[]
  serviceItems      ServiceItem[]
  inventoryItems    InventoryItem[]
  suppliers         Supplier[]
  hmoProviders      HmoProvider[]
  corporateAccounts CorporateAccount[]
  diagnosticTests   DiagnosticTest[]
  auditLogs         AuditLog[]

  @@map("organizations")
}

model Branch {
  id                    String    @id @default(uuid(7)) @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  code                  String // short code used in document numbers, e.g. "TAG"
  name                  String
  birBranchCode         String?   @map("bir_branch_code") // last 3-5 digits of TIN, e.g. "00001"
  dohLicenseNo          String?   @map("doh_license_no") // DOH License to Operate (clinic / lab)
  dohLicenseExpiry      DateTime? @map("doh_license_expiry") @db.Date
  philhealthAccreditNo  String?   @map("philhealth_accredit_no") // facility accreditation (e.g. Konsulta/YAKAP provider)
  philhealthAccreditExp DateTime? @map("philhealth_accredit_exp") @db.Date
  addressLine           String?   @map("address_line")
  barangayCode          String?   @map("barangay_code")
  cityMunicipalityCode  String?   @map("city_municipality_code")
  zipCode               String?   @map("zip_code")
  contactNo             String?   @map("contact_no")
  email                 String?
  isActive              Boolean   @default(true) @map("is_active")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization     Organization      @relation(fields: [organizationId], references: [id])
  barangay         Barangay?         @relation(fields: [barangayCode], references: [code])
  cityMunicipality CityMunicipality? @relation(fields: [cityMunicipalityCode], references: [code])

  userRoles           UserBranchRole[]
  documentSequences   DocumentSequence[]
  practitioners       PractitionerBranch[]
  schedules           PractitionerSchedule[]
  appointments        Appointment[]
  queueTickets        QueueTicket[]
  encounters          Encounter[]
  konsultaEnrollments KonsultaEnrollment[]
  branchPrices        BranchServicePrice[]
  invoiceSeries       InvoiceSeries[]
  invoices            Invoice[]
  payments            Payment[]
  cashierShifts       CashierShift[]
  inventoryLots       InventoryLot[]
  stockMovements      StockMovement[]
  stockReceipts       StockReceipt[]

  @@unique([organizationId, code])
  @@map("branches")
}

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  email        String    @unique
  username     String?   @unique
  passwordHash String?   @map("password_hash")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  mobileNo     String?   @map("mobile_no")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  branchRoles   UserBranchRole[]
  practitioner  Practitioner?
  cashierShifts CashierShift[]
  auditLogs     AuditLog[]

  @@map("users")
}

/// A user can hold different roles per branch (e.g. doctor in one, admin in another)
model UserBranchRole {
  id       String    @id @default(uuid(7)) @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  branchId String    @map("branch_id") @db.Uuid
  role     StaffRole

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId, role])
  @@map("user_branch_roles")
}

/// Per-branch running numbers for human-readable IDs (MRN, encounter no, Rx no, etc.)
/// Use SELECT ... FOR UPDATE / atomic increment when issuing.
model DocumentSequence {
  id        String  @id @default(uuid(7)) @db.Uuid
  branchId  String  @map("branch_id") @db.Uuid
  key       String // PATIENT | ENCOUNTER | RX | LAB_ORDER | MED_CERT | PAYMENT ...
  prefix    String? // e.g. "TAG-RX-"
  year      Int? // null = never resets; set to reset yearly
  nextValue Int     @default(1) @map("next_value")
  padLength Int     @default(6) @map("pad_length")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, key, year])
  @@map("document_sequences")
}
