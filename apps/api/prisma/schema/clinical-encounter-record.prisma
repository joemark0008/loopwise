// The clinical record of an encounter: vitals, diagnoses, and the patient's allergies (DESIGN.md §5).
// Every row names the patient and the organization (tenant), so row-level security can filter on them; rows of an
// encounter reference it by (encounter_id, patient_id), so they can never point at another patient's visit.
// Wrong entries are voided, never deleted.

/// One set of measurements; an encounter can have several (BP is often re-taken). Units are in the column names.
model VitalSigns {
  id               String       @id @default(uuid())
  encounterId      String       @map("encounter_id")
  patientId        String       @map("patient_id")
  orgId            String       @map("org_id")
  systolicMmHg     Int?         @map("systolic_mmhg")
  diastolicMmHg    Int?         @map("diastolic_mmhg")
  heartRateBpm     Int?         @map("heart_rate_bpm")
  respiratoryRate  Int?         @map("respiratory_rate")
  temperatureC     Decimal?     @map("temperature_c") @db.Decimal(4, 1)
  spo2Pct          Int?         @map("spo2_pct")
  weightKg         Decimal?     @map("weight_kg") @db.Decimal(5, 2)
  heightCm         Decimal?     @map("height_cm") @db.Decimal(5, 1)
  /// Computed from weight and height when both are set (stored so the dashboard can query it).
  bmi              Decimal?     @db.Decimal(4, 1)
  /// Capillary blood glucose.
  bloodGlucoseMgDl Int?         @map("blood_glucose_mg_dl")
  painScore        Int?         @map("pain_score")
  recordedAt       DateTime     @default(now()) @map("recorded_at") @db.Timestamp(6)
  recordedById     String       @map("recorded_by_id")
  voidedAt         DateTime?    @map("voided_at") @db.Timestamp(6)
  voidedById       String?      @map("voided_by_id")
  voidReason       String?      @map("void_reason")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  encounter        Encounter    @relation(fields: [encounterId, patientId], references: [id, patientId], onUpdate: NoAction, map: "vital_signs_encounter_fk")
  patient          Patient      @relation(fields: [patientId], references: [id], onUpdate: NoAction, map: "vital_signs_patient_id_patient_id_fk")
  organization     Organization @relation(fields: [orgId], references: [id], onUpdate: NoAction, map: "vital_signs_org_id_organization_id_fk")
  recordedBy       User         @relation(fields: [recordedById], references: [id], onUpdate: NoAction, map: "vital_signs_recorded_by_id_user_id_fk")

  @@index([encounterId, recordedAt], map: "vital_signs_encounterId_recordedAt_idx")
  @@index([patientId, recordedAt], map: "vital_signs_patientId_recordedAt_idx")
  @@map("vital_signs")
}

/// A diagnosis of the encounter, coded in ICD-10 (WHO 2010, as PhilHealth uses). One primary per encounter.
model EncounterDiagnosis {
  id           String             @id @default(uuid())
  encounterId  String             @map("encounter_id")
  patientId    String             @map("patient_id")
  orgId        String             @map("org_id")
  icd10Code    String             @map("icd10_code")
  /// The code's title when it was recorded.
  display      String
  certainty    DiagnosisCertainty @default(provisional)
  isPrimary    Boolean            @default(false) @map("is_primary")
  rank         Int                @default(0)
  notes        String?
  recordedById String             @map("recorded_by_id")
  voidedAt     DateTime?          @map("voided_at") @db.Timestamp(6)
  voidedById   String?            @map("voided_by_id")
  voidReason   String?            @map("void_reason")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  encounter    Encounter          @relation(fields: [encounterId, patientId], references: [id, patientId], onUpdate: NoAction, map: "encounter_diagnosis_encounter_fk")
  patient      Patient            @relation(fields: [patientId], references: [id], onUpdate: NoAction, map: "encounter_diagnosis_patient_id_patient_id_fk")
  organization Organization       @relation(fields: [orgId], references: [id], onUpdate: NoAction, map: "encounter_diagnosis_org_id_organization_id_fk")
  recordedBy   User               @relation(fields: [recordedById], references: [id], onUpdate: NoAction, map: "encounter_diagnosis_recorded_by_id_user_id_fk")

  @@unique([encounterId], map: "encounter_diagnosis_one_primary", where: raw("(is_primary AND voided_at IS NULL)"))
  @@index([encounterId], map: "encounter_diagnosis_encounterId_idx")
  @@index([icd10Code], map: "encounter_diagnosis_icd10Code_idx")
  @@map("encounter_diagnosis")
}

/// A known allergy of the patient (not of one visit). New prescription items are checked against it.
model PatientAllergy {
  id           String           @id @default(uuid())
  patientId    String           @map("patient_id")
  orgId        String           @map("org_id")
  substance    String
  kind         AllergyKind      @default(drug)
  reaction     String?
  severity     AllergySeverity?
  recordedById String           @map("recorded_by_id")
  voidedAt     DateTime?        @map("voided_at") @db.Timestamp(6)
  voidedById   String?          @map("voided_by_id")
  voidReason   String?          @map("void_reason")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  patient      Patient          @relation(fields: [patientId], references: [id], onUpdate: NoAction, map: "patient_allergy_patient_id_patient_id_fk")
  organization Organization     @relation(fields: [orgId], references: [id], onUpdate: NoAction, map: "patient_allergy_org_id_organization_id_fk")
  recordedBy   User             @relation(fields: [recordedById], references: [id], onUpdate: NoAction, map: "patient_allergy_recorded_by_id_user_id_fk")

  @@index([patientId], map: "patient_allergy_patientId_idx")
  @@map("patient_allergy")
}

/// What prescriptions and certificates need about a clinician: the PRC license, PTR number and credentials.
model ClinicianProfile {
  userId           String   @id @map("user_id")
  /// e.g. "MD".
  credentials      String?
  specialty        String?
  prcLicenseNumber String?  @map("prc_license_number")
  ptrNumber        String?  @map("ptr_number")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "clinician_profile_user_id_user_id_fk")

  @@map("clinician_profile")
}
