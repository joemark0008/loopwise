// Template-based messages to and from patients.
// Every clinical row names the organization (tenant) it belongs to, so row-level security can filter on it.

/// A message to or from the patient, always from an approved template (DESIGN.md §5).
model PatientMessage {
  id          String         @id @default(uuid())
  caseId      String?        @map("case_id")
  patientId   String         @map("patient_id")
  channel     MessageChannel
  templateKey String         @map("template_key")
  language    String
  body        String
  status      MessageStatus  @default(draft)
  createdById String?        @map("created_by_id")
  sentAt      DateTime?      @map("sent_at") @db.Timestamp(6)
  ackAt       DateTime?      @map("ack_at") @db.Timestamp(6)
  reply       String?
  repliedAt   DateTime?      @map("replied_at") @db.Timestamp(6)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  case        CareCase?      @relation(fields: [caseId], references: [id], onUpdate: NoAction, map: "patient_message_case_id_care_case_id_fk")
  patient     Patient        @relation(fields: [patientId], references: [id], onUpdate: NoAction, map: "patient_message_patient_id_patient_id_fk")
  createdBy   User?          @relation(fields: [createdById], references: [id], onUpdate: NoAction, map: "patient_message_created_by_id_user_id_fk")

  @@index([caseId], map: "patient_message_caseId_idx")
  @@index([patientId, createdAt], map: "patient_message_patientId_createdAt_idx")
  @@map("patient_message")
}
