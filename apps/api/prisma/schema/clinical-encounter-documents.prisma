// Documents issued from an encounter: prescriptions and medical certificates (DESIGN.md §5).
// A draft is editable; issuing snapshots the clinician and facility and makes the row immutable (a trigger allows
// only voiding). Rows reference the encounter by (encounter_id, patient_id).

/// A prescription (℞). Items name the generic first (Generics Act, RA 6675); the brand is optional.
model Prescription {
  id                String             @id @default(uuid())
  encounterId       String             @map("encounter_id")
  patientId         String             @map("patient_id")
  orgId             String             @map("org_id")
  prescriberId      String             @map("prescriber_id")
  status            DocumentStatus     @default(draft)
  /// Set on issue, e.g. `RX-20261103-4F2A9C`.
  rxNumber          String?            @unique(map: "prescription_rx_number_unique") @map("rx_number")
  notes             String?
  issuedAt          DateTime?          @map("issued_at") @db.Timestamp(6)
  prescriberName    String?            @map("prescriber_name")
  prescriberLicense String?            @map("prescriber_license")
  prescriberPtr     String?            @map("prescriber_ptr")
  facilityName      String?            @map("facility_name")
  facilityAddress   String?            @map("facility_address")
  voidedAt          DateTime?          @map("voided_at") @db.Timestamp(6)
  voidedById        String?            @map("voided_by_id")
  voidReason        String?            @map("void_reason")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  /// Bumped by a trigger on every update; a Wise card saves against the version it showed.
  version           Int                @default(1)
  encounter         Encounter          @relation(fields: [encounterId, patientId], references: [id, patientId], onUpdate: NoAction, map: "prescription_encounter_fk")
  patient           Patient            @relation(fields: [patientId], references: [id], onUpdate: NoAction, map: "prescription_patient_id_patient_id_fk")
  organization      Organization       @relation(fields: [orgId], references: [id], onUpdate: NoAction, map: "prescription_org_id_organization_id_fk")
  prescriber        User               @relation(fields: [prescriberId], references: [id], onUpdate: NoAction, map: "prescription_prescriber_id_user_id_fk")
  items             PrescriptionItem[]

  @@index([encounterId], map: "prescription_encounterId_idx")
  @@index([patientId], map: "prescription_patientId_idx")
  @@map("prescription")
}

/// One medicine on a prescription. A later pharmacy feature's dispense rows point here (Evidence type `dispense`).
model PrescriptionItem {
  id             String          @id @default(uuid())
  prescriptionId String          @map("prescription_id")
  position       Int             @default(0)
  genericName    String          @map("generic_name")
  brandName      String?         @map("brand_name")
  /// e.g. "500 mg".
  strength       String?
  /// e.g. "tablet", "capsule", "syrup".
  form           String?
  /// e.g. "1 tablet".
  dose           String
  route          MedicationRoute @default(oral)
  /// e.g. "twice a day".
  frequency      String
  durationDays   Int?            @map("duration_days")
  quantity       Int
  quantityUnit   String?         @map("quantity_unit")
  refills        Int             @default(0)
  /// The sig for the patient, e.g. "Take after breakfast".
  instructions   String?
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamp(6)
  prescription   Prescription    @relation(fields: [prescriptionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "prescription_item_prescription_id_prescription_id_fk")

  @@index([prescriptionId, position], map: "prescription_item_prescriptionId_position_idx")
  @@map("prescription_item")
}

/// A medical certificate from the encounter: diagnosis, rest days and fitness to work, signed by the clinician.
model MedicalCertificate {
  id                String         @id @default(uuid())
  encounterId       String         @map("encounter_id")
  patientId         String         @map("patient_id")
  orgId             String         @map("org_id")
  issuedById        String         @map("issued_by_id")
  status            DocumentStatus @default(draft)
  /// Set on issue, e.g. `MC-20261103-4F2A9C`.
  certificateNumber String?        @unique(map: "medical_certificate_number_unique") @map("certificate_number")
  examinedOn        DateTime       @map("examined_on") @db.Date
  diagnosisText     String         @map("diagnosis_text")
  fitness           WorkFitness    @default(fit_to_work)
  restFrom          DateTime?      @map("rest_from") @db.Date
  restDays          Int?           @map("rest_days")
  remarks           String?
  /// What the certificate is for, e.g. "work" or "school".
  purpose           String?
  issuedAt          DateTime?      @map("issued_at") @db.Timestamp(6)
  doctorName        String?        @map("doctor_name")
  doctorLicense     String?        @map("doctor_license")
  doctorPtr         String?        @map("doctor_ptr")
  facilityName      String?        @map("facility_name")
  facilityAddress   String?        @map("facility_address")
  voidedAt          DateTime?      @map("voided_at") @db.Timestamp(6)
  voidedById        String?        @map("voided_by_id")
  voidReason        String?        @map("void_reason")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  /// Bumped by a trigger on every update; a Wise card saves against the version it showed.
  version           Int            @default(1)
  encounter         Encounter      @relation(fields: [encounterId, patientId], references: [id, patientId], onUpdate: NoAction, map: "medical_certificate_encounter_fk")
  patient           Patient        @relation(fields: [patientId], references: [id], onUpdate: NoAction, map: "medical_certificate_patient_id_patient_id_fk")
  organization      Organization   @relation(fields: [orgId], references: [id], onUpdate: NoAction, map: "medical_certificate_org_id_organization_id_fk")
  issuedBy          User           @relation(fields: [issuedById], references: [id], onUpdate: NoAction, map: "medical_certificate_issued_by_id_user_id_fk")

  @@index([encounterId], map: "medical_certificate_encounterId_idx")
  @@index([patientId], map: "medical_certificate_patientId_idx")
  @@map("medical_certificate")
}
