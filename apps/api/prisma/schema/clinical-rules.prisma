// Rules engine evaluations (DESIGN.md §6.2, §6.3 step 3): why a result is normal, actionable or critical. Written by
// system work, append-only (a trigger rejects UPDATE and DELETE); readable by whoever can read the result (RLS).

enum ResultClassification {
  normal
  actionable
  critical

  @@map("result_classification")
}

model ResultEvaluation {
  id             String               @id @default(uuid())
  resultId       String               @map("result_id")
  pathwayKey     String               @map("pathway_key")
  /// The pathway's `version` the rule came from.
  ruleVersion    Int                  @map("rule_version")
  classification ResultClassification
  urgency        Urgency
  reason         String
  guideline      String
  /// The case state the case engine should aim for (DESIGN.md §8).
  nextState      CaseState            @map("next_state")
  slaHours       Float?               @map("sla_hours")
  /// band | critical_flag | unrecognised (`@loopwise/shared/rules-engine`).
  basis          String
  /// The rule that fired: code, band, the value as compared and as received.
  rule           Json
  evaluatedAt    DateTime             @default(now()) @map("evaluated_at") @db.Timestamp(6)
  result         Result               @relation(fields: [resultId], references: [id], onUpdate: NoAction, map: "result_evaluation_result_id_result_id_fk")
  pathway        Pathway              @relation(fields: [pathwayKey], references: [key], map: "result_evaluation_pathway_key_pathway_key_fk")

  @@unique([resultId, pathwayKey, ruleVersion], map: "result_evaluation_result_rule_unique")
  @@index([resultId, evaluatedAt], map: "result_evaluation_resultId_evaluatedAt_idx")
  @@map("result_evaluation")
}
