// Ordered tests and their results.
// Every clinical row names the organization (tenant) it belongs to, so row-level security can filter on it.

/// A test ordered for a patient (FHIR ServiceRequest). `order` is an SQL keyword, hence the table name.
model ClinicalOrder {
  id               String        @id @default(uuid())
  encounterId      String?       @map("encounter_id")
  patientId        String        @map("patient_id")
  orderingDoctorId String        @map("ordering_doctor_id")
  orderingOrgId    String        @map("ordering_org_id")
  targetOrgId      String        @map("target_org_id")
  /// LOINC code where available, otherwise the facility's local code.
  code             String
  codeSystem       String        @default("LOINC") @map("code_system")
  display          String?
  priority         OrderPriority @default(routine)
  status           OrderStatus   @default(draft)
  notes            String?
  sentAt           DateTime?     @map("sent_at") @db.Timestamp(6)
  acceptedAt       DateTime?     @map("accepted_at") @db.Timestamp(6)
  collectedAt      DateTime?     @map("collected_at") @db.Timestamp(6)
  resultedAt       DateTime?     @map("resulted_at") @db.Timestamp(6)
  reviewedAt       DateTime?     @map("reviewed_at") @db.Timestamp(6)
  /// When it was rejected or cancelled.
  closedAt         DateTime?     @map("closed_at") @db.Timestamp(6)
  /// Why it was rejected or cancelled.
  statusReason     String?       @map("status_reason")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  encounter        Encounter?    @relation(fields: [encounterId], references: [id], onUpdate: NoAction, map: "clinical_order_encounter_id_encounter_id_fk")
  patient          Patient       @relation(fields: [patientId], references: [id], onUpdate: NoAction, map: "clinical_order_patient_id_patient_id_fk")
  orderingDoctor   User          @relation(fields: [orderingDoctorId], references: [id], onUpdate: NoAction, map: "clinical_order_ordering_doctor_id_user_id_fk")
  orderingOrg      Organization  @relation("clinical_order_ordering_org", fields: [orderingOrgId], references: [id], onUpdate: NoAction, map: "clinical_order_ordering_org_id_organization_id_fk")
  targetOrg        Organization  @relation("clinical_order_target_org", fields: [targetOrgId], references: [id], onUpdate: NoAction, map: "clinical_order_target_org_id_organization_id_fk")
  results          Result[]
  hl7Outbox        Hl7Outbox[]

  @@index([patientId], map: "clinical_order_patientId_idx")
  @@index([targetOrgId, status], map: "clinical_order_targetOrgId_status_idx")
  @@index([orderingDoctorId, status], map: "clinical_order_orderingDoctorId_status_idx")
  @@map("clinical_order")
}

/// A lab or imaging result (FHIR Observation / DiagnosticReport). `rawHl7` keeps the ORU message it came from.
model Result {
  id             String             @id @default(uuid())
  orderId        String?            @map("order_id")
  patientId      String             @map("patient_id")
  sourceOrgId    String             @map("source_org_id")
  code           String
  codeSystem     String             @default("LOINC") @map("code_system")
  display        String?
  value          String
  valueNumeric   Decimal?           @map("value_numeric") @db.Decimal(18, 6)
  unit           String?
  refRange       String?            @map("ref_range")
  flag           ResultFlag?
  rawHl7         String?            @map("raw_hl7")
  resultedAt     DateTime           @map("resulted_at") @db.Timestamp(6)
  receivedAt     DateTime           @default(now()) @map("received_at") @db.Timestamp(6)
  reviewedAt     DateTime?          @map("reviewed_at") @db.Timestamp(6)
  reviewedById   String?            @map("reviewed_by_id")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  order          ClinicalOrder?     @relation(fields: [orderId], references: [id], onUpdate: NoAction, map: "result_order_id_clinical_order_id_fk")
  patient        Patient            @relation(fields: [patientId], references: [id], onUpdate: NoAction, map: "result_patient_id_patient_id_fk")
  sourceOrg      Organization       @relation(fields: [sourceOrgId], references: [id], onUpdate: NoAction, map: "result_source_org_id_organization_id_fk")
  reviewedBy     User?              @relation(fields: [reviewedById], references: [id], onUpdate: NoAction, map: "result_reviewed_by_id_user_id_fk")
  triggeredCases CareCase[]
  evaluations    ResultEvaluation[]

  @@index([patientId, resultedAt], map: "result_patientId_resultedAt_idx")
  @@index([orderId], map: "result_orderId_idx")
  @@index([receivedAt], map: "result_awaiting_review_idx", where: raw("(reviewed_at IS NULL)"))
  @@map("result")
}

/// An outbound HL7 v2 message (ORM^O01) waiting for the target facility's edge connector, which pulls it
/// (`GET /api/hl7/outbox`) and posts the lab system's ACK back. Facilities without a connector use the worklist.
model Hl7Outbox {
  id            String          @id @default(uuid())
  orgId         String          @map("org_id")
  orderId       String          @map("order_id")
  /// e.g. `ORM^O01`.
  messageType   String          @map("message_type")
  /// MSH-10.
  controlId     String          @unique(map: "hl7_outbox_control_id_unique") @map("control_id")
  message       String
  status        Hl7OutboxStatus @default(pending)
  /// How many times the connector fetched it.
  attempts      Int             @default(0)
  /// MSA-1: AA, AE or AR.
  ackCode       String?         @map("ack_code")
  ack           String?
  lastFetchedAt DateTime?       @map("last_fetched_at") @db.Timestamp(6)
  ackedAt       DateTime?       @map("acked_at") @db.Timestamp(6)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  organization  Organization    @relation(fields: [orgId], references: [id], onUpdate: NoAction, map: "hl7_outbox_org_id_organization_id_fk")
  order         ClinicalOrder   @relation(fields: [orderId], references: [id], onUpdate: NoAction, map: "hl7_outbox_order_id_clinical_order_id_fk")

  @@index([orgId, status, createdAt], map: "hl7_outbox_orgId_status_createdAt_idx")
  @@index([orderId], map: "hl7_outbox_orderId_idx")
  @@map("hl7_outbox")
}
