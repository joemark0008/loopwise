// =============================================================================
//  Loopwise: Wise chats, messages and their parts, feedback, shared chats, memories and chart images.
//  Message ids are UUIDs (the web client generates them with crypto.randomUUID).
// =============================================================================

model ChartImage {
  id         String   @id @default(uuid(7)) @db.Uuid
  toolCallId String   @unique @map("tool_call_id")
  data       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("chart_images")
}

model Chat {
  id                 String    @id @default(uuid(7)) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  clinicId           String    @map("clinic_id") @db.Uuid
  title              String    @default("New Conversation")
  /// `chat`, or `patient` for a chart chat (one per clinician per patient).
  surface            String    @default("chat")
  /// The patient a chart chat is about.
  patientId          String?   @map("patient_id") @db.Uuid
  isStarred          Boolean   @default(false) @map("is_starred")
  forkMetadata       Json?     @map("fork_metadata")
  slackThreadId      String?   @map("slack_thread_id")
  teamsThreadId      String?   @map("teams_thread_id")
  telegramThreadId   String?   @map("telegram_thread_id")
  whatsappThreadId   String?   @map("whatsapp_thread_id")
  mattermostThreadId String?   @map("mattermost_thread_id")
  discordThreadId    String?   @map("discord_thread_id")
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic        Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient       Patient?       @relation(fields: [patientId], references: [id], onDelete: SetNull)
  messages      ChatMessage[]
  llmInferences LlmInference[]
  memories      Memory[]
  sharedChat    SharedChat?

  @@unique([userId, patientId], map: "chats_one_chart_chat_per_user_patient", where: raw("((patient_id IS NOT NULL) AND (deleted_at IS NULL))"))
  @@index([clinicId])
  @@index([userId])
  @@index([slackThreadId])
  @@index([teamsThreadId])
  @@index([telegramThreadId])
  @@index([whatsappThreadId])
  @@index([mattermostThreadId])
  @@index([discordThreadId])
  @@map("chats")
}

model ChatMessage {
  id                    String    @id @default(uuid(7)) @db.Uuid
  chatId                String    @map("chat_id") @db.Uuid
  role                  String
  senderUserId          String?   @map("sender_user_id") @db.Uuid
  stopReason            String?   @map("stop_reason")
  errorMessage          String?   @map("error_message")
  llmProvider           String?   @map("llm_provider")
  llmModelId            String?   @map("llm_model_id")
  inputTotalTokens      Int?      @map("input_total_tokens")
  inputNoCacheTokens    Int?      @map("input_no_cache_tokens")
  inputCacheReadTokens  Int?      @map("input_cache_read_tokens")
  inputCacheWriteTokens Int?      @map("input_cache_write_tokens")
  outputTotalTokens     Int?      @map("output_total_tokens")
  outputTextTokens      Int?      @map("output_text_tokens")
  outputReasoningTokens Int?      @map("output_reasoning_tokens")
  totalTokens           Int?      @map("total_tokens")
  supersededAt          DateTime? @map("superseded_at") @db.Timestamptz(3)
  source                String?
  isForked              Boolean?  @map("is_forked")
  citation              Json?
  versionGroupId        String?   @map("version_group_id") @db.Uuid
  discordMessageId      String?   @map("discord_message_id")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  chat     Chat             @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender   User?            @relation(fields: [senderUserId], references: [id])
  feedback MessageFeedback?
  parts    MessagePart[]

  @@index([chatId, createdAt])
  @@index([createdAt])
  @@index([discordMessageId])
  @@index([senderUserId])
  @@index([versionGroupId])
  @@map("chat_messages")
}

model Memory {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  chatId       String?  @map("chat_id") @db.Uuid
  content      String
  category     String
  supersededBy String?  @map("superseded_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat Chat? @relation(fields: [chatId], references: [id])

  @@index([chatId])
  @@index([supersededBy])
  @@index([userId])
  @@map("memories")
}

model MessageFeedback {
  messageId   String   @id @map("message_id") @db.Uuid
  vote        String
  explanation String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_feedback")
}

model MessageImage {
  id        String        @id @default(uuid(7)) @db.Uuid
  data      String
  mediaType String        @map("media_type")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  parts     MessagePart[]

  @@map("message_images")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model MessagePart {
  id                   String   @id @default(uuid(7)) @db.Uuid
  messageId            String   @map("message_id") @db.Uuid
  order                Int
  type                 String
  text                 String?
  reasoningText        String?  @map("reasoning_text")
  toolCallId           String?  @unique @map("tool_call_id")
  toolName             String?  @map("tool_name")
  toolState            String?  @map("tool_state")
  toolErrorText        String?  @map("tool_error_text")
  toolInput            Json?    @map("tool_input")
  toolOutput           Json?    @map("tool_output")
  toolApprovalId       String?  @map("tool_approval_id")
  toolApprovalApproved Boolean? @map("tool_approval_approved")
  toolApprovalReason   String?  @map("tool_approval_reason")
  toolRawInput         Json?    @map("tool_raw_input")
  toolProviderMetadata Json?    @map("tool_provider_metadata")
  providerMetadata     Json?    @map("provider_metadata")
  mediaType            String?  @map("media_type")
  imageId              String?  @map("image_id") @db.Uuid
  storagePath          String?  @map("storage_path")
  filename             String?
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message ChatMessage   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  image   MessageImage? @relation(fields: [imageId], references: [id])

  @@index([messageId, order])
  @@map("message_parts")
}

model SharedChat {
  id         String   @id @default(uuid(7)) @db.Uuid
  chatId     String   @unique @map("chat_id") @db.Uuid
  /// `clinic` (everyone in the clinic) or `specific` (the users in `shared_chat_access`).
  visibility String   @default("clinic")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  chat   Chat               @relation(fields: [chatId], references: [id], onDelete: Cascade)
  access SharedChatAccess[]

  @@map("shared_chats")
}

model SharedChatAccess {
  sharedChatId String @map("shared_chat_id") @db.Uuid
  userId       String @map("user_id") @db.Uuid

  sharedChat SharedChat @relation(fields: [sharedChatId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sharedChatId, userId])
  @@map("shared_chat_access")
}
