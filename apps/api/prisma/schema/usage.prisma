// =============================================================================
//  Loopwise: LLM usage, one row per inference, for token and cost accounting.
// =============================================================================

model LlmInference {
  id                    String   @id @default(uuid(7)) @db.Uuid
  clinicId              String   @map("clinic_id") @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  chatId                String?  @map("chat_id") @db.Uuid
  type                  String
  llmProvider           String   @map("llm_provider")
  llmModelId            String   @map("llm_model_id")
  inputTotalTokens      Int?     @map("input_total_tokens")
  inputNoCacheTokens    Int?     @map("input_no_cache_tokens")
  inputCacheReadTokens  Int?     @map("input_cache_read_tokens")
  inputCacheWriteTokens Int?     @map("input_cache_write_tokens")
  outputTotalTokens     Int?     @map("output_total_tokens")
  outputTextTokens      Int?     @map("output_text_tokens")
  outputReasoningTokens Int?     @map("output_reasoning_tokens")
  totalTokens           Int?     @map("total_tokens")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat   Chat?  @relation(fields: [chatId], references: [id])

  @@index([createdAt])
  @@index([clinicId])
  @@index([type])
  @@index([userId])
  @@map("llm_inferences")
}
