// =============================================================================
//  DIAGNOSTICS — laboratory, imaging, ECG
//  Supports in-house and send-out tests; result fields ready for LIS (HL7 ORU).
// =============================================================================

enum DiagnosticCategory {
  LABORATORY
  IMAGING
  CARDIO // ECG, 2D echo
  OTHER

  @@map("diagnostic_category")
}

enum ResultValueType {
  NUMERIC
  TEXT
  OPTION // Positive / Negative / Reactive …

  @@map("result_value_type")
}

enum OrderPriority {
  ROUTINE
  URGENT
  STAT

  @@map("order_priority")
}

enum DiagnosticOrderStatus {
  REQUESTED
  PAID // many PH clinics collect payment before extraction
  SPECIMEN_COLLECTED
  IN_PROGRESS
  RESULTED
  RELEASED
  CANCELLED

  @@map("diagnostic_order_status")
}

enum ResultFlag {
  NORMAL
  LOW
  HIGH
  CRITICAL_LOW
  CRITICAL_HIGH
  ABNORMAL

  @@map("result_flag")
}

/// Test catalog: CBC, FBS, Lipid Profile, Urinalysis, Fecalysis, Chest X-ray PA …
model DiagnosticTest {
  id              String             @id @default(uuid(7)) @db.Uuid
  organizationId  String             @map("organization_id") @db.Uuid
  code            String
  name            String
  category        DiagnosticCategory
  section         String? // Hematology, Clinical Chemistry, Clinical Microscopy, Serology, Microbiology, X-Ray, Ultrasound
  specimenType    String?            @map("specimen_type") // Whole blood, Serum, Urine, Stool
  requiresFasting Boolean            @default(false) @map("requires_fasting")
  turnaroundHours Int?               @map("turnaround_hours")
  isOutsourced    Boolean            @default(false) @map("is_outsourced")
  outsourcedLab   String?            @map("outsourced_lab")
  lisCode         String?            @map("lis_code") // mapping code for LIS / HL7 OBR-4
  isActive        Boolean            @default(true) @map("is_active")

  organization Organization              @relation(fields: [organizationId], references: [id])
  parameters   DiagnosticTestParameter[]
  orderItems   DiagnosticOrderItem[]
  serviceItem  ServiceItem?

  @@unique([organizationId, code])
  @@map("diagnostic_tests")
}

/// Analytes of a test (e.g. CBC → Hgb, Hct, WBC, Platelet). Reference ranges by sex.
model DiagnosticTestParameter {
  id            String          @id @default(uuid(7)) @db.Uuid
  testId        String          @map("test_id") @db.Uuid
  code          String
  name          String
  unit          String? // g/L, mmol/L (SI is common in PH labs), mg/dL
  valueType     ResultValueType @default(NUMERIC) @map("value_type")
  options       String[] // for OPTION type
  refLowMale    Decimal?        @map("ref_low_male") @db.Decimal(12, 4)
  refHighMale   Decimal?        @map("ref_high_male") @db.Decimal(12, 4)
  refLowFemale  Decimal?        @map("ref_low_female") @db.Decimal(12, 4)
  refHighFemale Decimal?        @map("ref_high_female") @db.Decimal(12, 4)
  refRangeText  String?         @map("ref_range_text") // when range is not numeric
  lisCode       String?         @map("lis_code") // HL7 OBX-3 mapping
  sortOrder     Int             @default(0) @map("sort_order")

  test         DiagnosticTest          @relation(fields: [testId], references: [id], onDelete: Cascade)
  resultValues DiagnosticResultValue[]

  @@unique([testId, code])
  @@map("diagnostic_test_parameters")
}

model DiagnosticOrder {
  id                String                @id @default(uuid(7)) @db.Uuid
  orderNo           String                @unique @map("order_no")
  encounterId       String                @map("encounter_id") @db.Uuid
  requestedById     String?               @map("requested_by_id") @db.Uuid // Practitioner
  externalPhysician String?               @map("external_physician") // walk-in lab with outside doctor\'s request (LAB_ONLY encounter)
  priority          OrderPriority         @default(ROUTINE)
  status            DiagnosticOrderStatus @default(REQUESTED)
  clinicalInfo      String?               @map("clinical_info") // diagnosis / indication shown on request form
  isExternal        Boolean               @default(false) @map("is_external") // request to be done outside
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  encounter         Encounter             @relation(fields: [encounterId], references: [id])
  requestedBy       Practitioner?         @relation(fields: [requestedById], references: [id])
  items             DiagnosticOrderItem[]

  @@index([encounterId])
  @@index([status])
  @@map("diagnostic_orders")
}

model DiagnosticOrderItem {
  id                  String                @id @default(uuid(7)) @db.Uuid
  orderId             String                @map("order_id") @db.Uuid
  testId              String                @map("test_id") @db.Uuid
  status              DiagnosticOrderStatus @default(REQUESTED)
  accessionNo         String?               @map("accession_no") // specimen barcode / LIS accession
  specimenCollectedAt DateTime?             @map("specimen_collected_at") @db.Timestamptz(3)
  collectedById       String?               @map("collected_by_id") @db.Uuid
  // Loopwise: why the item was cancelled (by the ordering clinician, or refused by the lab), and when.
  statusReason        String?               @map("status_reason")
  cancelledAt         DateTime?             @map("cancelled_at") @db.Timestamptz(3)

  order  DiagnosticOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  test   DiagnosticTest    @relation(fields: [testId], references: [id])
  result DiagnosticResult?

  @@index([orderId])
  @@index([accessionNo])
  @@map("diagnostic_order_items")
}

model DiagnosticResult {
  id            String    @id @default(uuid(7)) @db.Uuid
  orderItemId   String    @unique @map("order_item_id") @db.Uuid
  performedById String?   @map("performed_by_id") @db.Uuid // MedTech / RadTech (User)
  verifiedById  String?   @map("verified_by_id") @db.Uuid // senior MedTech (User)
  signedById    String?   @map("signed_by_id") @db.Uuid // Pathologist / Radiologist (Practitioner)
  findings      String? // imaging narrative
  impression    String?
  remarks       String?
  attachmentUrl String?   @map("attachment_url") // PDF / DICOM viewer link
  hl7MessageId  String?   @map("hl7_message_id") // MSH-10 when received from LIS
  resultedAt    DateTime? @map("resulted_at") @db.Timestamptz(3)
  releasedAt    DateTime? @map("released_at") @db.Timestamptz(3)
  // Loopwise: the doctor reviewed the released result in the results inbox. Critical values never get an automated
  // patient message.
  reviewedAt    DateTime? @map("reviewed_at") @db.Timestamptz(3)
  reviewedById  String?   @map("reviewed_by_id") @db.Uuid

  orderItem DiagnosticOrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  signedBy  Practitioner?           @relation(fields: [signedById], references: [id])
  values    DiagnosticResultValue[]

  @@map("diagnostic_results")
}

model DiagnosticResultValue {
  id             String      @id @default(uuid(7)) @db.Uuid
  resultId       String      @map("result_id") @db.Uuid
  parameterId    String?     @map("parameter_id") @db.Uuid
  name           String // snapshot of parameter name
  value          String
  numericValue   Decimal?    @map("numeric_value") @db.Decimal(12, 4)
  unit           String?
  referenceRange String?     @map("reference_range") // snapshot as printed
  flag           ResultFlag?

  result    DiagnosticResult         @relation(fields: [resultId], references: [id], onDelete: Cascade)
  parameter DiagnosticTestParameter? @relation(fields: [parameterId], references: [id])

  @@index([resultId])
  @@map("diagnostic_result_values")
}
