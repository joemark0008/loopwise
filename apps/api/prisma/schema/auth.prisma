// Authentication: better-auth tables (account, session, verification) and organization API keys.

model Account {
  id                    String    @id @default(uuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamp(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamp(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "account_user_id_user_id_fk")

  @@index([userId], map: "account_userId_idx")
  @@map("account")
}

model ApiKey {
  id           String       @id @default(uuid())
  orgId        String       @map("org_id")
  name         String
  keyHash      String       @unique(map: "api_key_key_hash_unique") @map("key_hash")
  keyPrefix    String       @map("key_prefix")
  createdBy    String       @map("created_by")
  lastUsedAt   DateTime?    @map("last_used_at") @db.Timestamp(6)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  user         User         @relation(fields: [createdBy], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "api_key_created_by_user_id_fk")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "api_key_org_id_organization_id_fk")

  @@index([orgId], map: "api_key_orgId_idx")
  @@map("api_key")
}

model Jwks {
  id         String    @id @default(uuid())
  publicKey  String    @map("public_key")
  privateKey String    @map("private_key")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  expiresAt  DateTime? @map("expires_at") @db.Timestamp(6)

  @@map("jwks")
}

model OauthAccessToken {
  id                String             @id @default(uuid())
  token             String             @unique(map: "oauth_access_token_token_unique")
  clientId          String             @map("client_id")
  sessionId         String?            @map("session_id")
  userId            String?            @map("user_id")
  referenceId       String?            @map("reference_id")
  refreshId         String?            @map("refresh_id")
  expiresAt         DateTime           @map("expires_at") @db.Timestamp(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  scopes            Json
  oauthClient       OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade, onUpdate: NoAction, map: "oauth_access_token_client_id_oauth_client_client_id_fk")
  oauthRefreshToken OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "oauth_access_token_refresh_id_oauth_refresh_token_id_fk")
  session           Session?           @relation(fields: [sessionId], references: [id], onUpdate: NoAction, map: "oauth_access_token_session_id_session_id_fk")
  user              User?              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "oauth_access_token_user_id_user_id_fk")

  @@index([clientId], map: "oauth_access_token_clientId_idx")
  @@index([refreshId], map: "oauth_access_token_refreshId_idx")
  @@index([userId], map: "oauth_access_token_userId_idx")
  @@map("oauth_access_token")
}

model OauthClient {
  id                      String              @id @default(uuid())
  clientId                String              @unique(map: "oauth_client_client_id_unique") @map("client_id")
  clientSecret            String?             @map("client_secret")
  disabled                Boolean?            @default(false)
  skipConsent             Boolean?            @map("skip_consent")
  enableEndSession        Boolean?            @map("enable_end_session")
  subjectType             String?             @map("subject_type")
  scopes                  Json?
  userId                  String?             @map("user_id")
  name                    String?
  uri                     String?
  icon                    String?
  contacts                Json?
  tos                     String?
  policy                  String?
  softwareId              String?             @map("software_id")
  softwareVersion         String?             @map("software_version")
  softwareStatement       String?             @map("software_statement")
  redirectUris            Json                @map("redirect_uris")
  postLogoutRedirectUris  Json?               @map("post_logout_redirect_uris")
  tokenEndpointAuthMethod String?             @map("token_endpoint_auth_method")
  grantTypes              Json?               @map("grant_types")
  responseTypes           Json?               @map("response_types")
  public                  Boolean?
  type                    String?
  requirePkce             Boolean?            @map("require_pkce")
  referenceId             String?             @map("reference_id")
  metadata                Json?
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  oauthAccessTokens       OauthAccessToken[]
  user                    User?               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "oauth_client_user_id_user_id_fk")
  oauthConsents           OauthConsent[]
  oauthRefreshTokens      OauthRefreshToken[]

  @@index([userId], map: "oauth_client_userId_idx")
  @@map("oauth_client")
}

model OauthConsent {
  id          String      @id @default(uuid())
  clientId    String      @map("client_id")
  userId      String?     @map("user_id")
  referenceId String?     @map("reference_id")
  scopes      Json
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  oauthClient OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade, onUpdate: NoAction, map: "oauth_consent_client_id_oauth_client_client_id_fk")
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "oauth_consent_user_id_user_id_fk")

  @@index([clientId], map: "oauth_consent_clientId_idx")
  @@index([userId], map: "oauth_consent_userId_idx")
  @@map("oauth_consent")
}

model OauthRefreshToken {
  id                String             @id @default(uuid())
  token             String             @unique(map: "oauth_refresh_token_token_unique")
  clientId          String             @map("client_id")
  sessionId         String?            @map("session_id")
  userId            String             @map("user_id")
  referenceId       String?            @map("reference_id")
  expiresAt         DateTime           @map("expires_at") @db.Timestamp(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  revoked           DateTime?          @db.Timestamp(6)
  authTime          DateTime?          @map("auth_time") @db.Timestamp(6)
  scopes            Json
  oauthAccessTokens OauthAccessToken[]
  oauthClient       OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade, onUpdate: NoAction, map: "oauth_refresh_token_client_id_oauth_client_client_id_fk")
  session           Session?           @relation(fields: [sessionId], references: [id], onUpdate: NoAction, map: "oauth_refresh_token_session_id_session_id_fk")
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "oauth_refresh_token_user_id_user_id_fk")

  @@index([clientId], map: "oauth_refresh_token_clientId_idx")
  @@index([sessionId], map: "oauth_refresh_token_sessionId_idx")
  @@index([userId], map: "oauth_refresh_token_userId_idx")
  @@map("oauth_refresh_token")
}

model Session {
  id                 String              @id @default(uuid())
  expiresAt          DateTime            @map("expires_at") @db.Timestamp(6)
  token              String              @unique(map: "session_token_unique")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamp(6)
  ipAddress          String?             @map("ip_address")
  userAgent          String?             @map("user_agent")
  userId             String              @map("user_id")
  oauthAccessTokens  OauthAccessToken[]
  oauthRefreshTokens OauthRefreshToken[]
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "session_user_id_user_id_fk")

  @@index([userId], map: "session_userId_idx")
  @@map("session")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamp(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([identifier])
  @@map("verification")
}
