// Wise tool settings (DESIGN.md §9.4): which Wise tools a facility turned on or off, and the ones a user turned off for
// themselves. Rows are overrides only; without one the catalogue's default for the facility type applies
// (`@quarry/shared/wise-tools`). The foreign keys to `organization` and `user` (cascade) live in the migration only, so
// those models stay as they are.

model WiseToolSetting {
  id          String   @id @default(uuid())
  /// The facility's setting; null for a user's own opt-out (then `userId` is set).
  orgId       String?  @map("org_id")
  /// A user's own opt-out, everywhere they work; null for a facility's setting.
  userId      String?  @map("user_id")
  toolName    String   @map("tool_name")
  enabled     Boolean
  updatedById String   @map("updated_by_id")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([orgId], map: "wise_tool_setting_orgId_idx")
  @@index([userId], map: "wise_tool_setting_userId_idx")
  @@map("wise_tool_setting")
}
