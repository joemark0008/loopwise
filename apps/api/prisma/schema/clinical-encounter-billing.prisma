// The bill of an encounter: a short list of charges, an optional senior/PWD discount and PhilHealth package
// (DESIGN.md §5). A draft is editable; a finalized bill can only be marked paid or voided (a trigger enforces it).
// Out of scope: eClaims and claim forms, HMOs, BIR receipts, payment processing.

model EncounterBill {
  id                    String            @id @default(uuid())
  encounterId           String            @map("encounter_id")
  patientId             String            @map("patient_id")
  orgId                 String            @map("org_id")
  status                BillStatus        @default(draft)
  subtotal              Decimal           @default(0) @db.Decimal(12, 2)
  discountKind          BillDiscountKind? @map("discount_kind")
  discountAmount        Decimal           @default(0) @map("discount_amount") @db.Decimal(12, 2)
  /// e.g. a Konsulta package or a case-rate code.
  philhealthPackageCode String?           @map("philhealth_package_code")
  philhealthCoverage    Decimal           @default(0) @map("philhealth_coverage") @db.Decimal(12, 2)
  total                 Decimal           @default(0) @db.Decimal(12, 2)
  finalizedAt           DateTime?         @map("finalized_at") @db.Timestamp(6)
  finalizedById         String?           @map("finalized_by_id")
  paidAt                DateTime?         @map("paid_at") @db.Timestamp(6)
  /// The official receipt number.
  orNumber              String?           @map("or_number")
  voidedAt              DateTime?         @map("voided_at") @db.Timestamp(6)
  voidedById            String?           @map("voided_by_id")
  voidReason            String?           @map("void_reason")
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  /// Bumped by a trigger on every update; a Wise card saves against the version it showed.
  version               Int               @default(1)
  encounter             Encounter         @relation(fields: [encounterId, patientId], references: [id, patientId], onUpdate: NoAction, map: "encounter_bill_encounter_fk")
  patient               Patient           @relation(fields: [patientId], references: [id], onUpdate: NoAction, map: "encounter_bill_patient_id_patient_id_fk")
  organization          Organization      @relation(fields: [orgId], references: [id], onUpdate: NoAction, map: "encounter_bill_org_id_organization_id_fk")
  charges               EncounterCharge[]

  /// One bill per encounter that is not voided; a voided bill can be replaced.
  @@unique([encounterId], map: "encounter_bill_encounter_unique", where: raw("(status <> 'voided'::bill_status)"))
  @@index([orgId, status], map: "encounter_bill_orgId_status_idx")
  @@map("encounter_bill")
}

model EncounterCharge {
  id          String        @id @default(uuid())
  billId      String        @map("bill_id")
  position    Int           @default(0)
  kind        ChargeKind
  description String
  /// A local fee code, LOINC for a lab test, or a PhilHealth code.
  code        String?
  quantity    Int           @default(1)
  unitPrice   Decimal       @map("unit_price") @db.Decimal(12, 2)
  amount      Decimal       @db.Decimal(12, 2)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  bill        EncounterBill @relation(fields: [billId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "encounter_charge_bill_id_encounter_bill_id_fk")

  @@index([billId, position], map: "encounter_charge_billId_position_idx")
  @@map("encounter_charge")
}
