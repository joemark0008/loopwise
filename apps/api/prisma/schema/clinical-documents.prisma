// Documents saved to a patient's chart (DESIGN.md §7.2): a Wise report version the clinician saved, frozen with the
// results it embeds, so the chart shows what they read. Append-only (a trigger rejects UPDATE and DELETE).

model ClinicalDocument {
  id               String   @id @default(uuid())
  patientId        String   @map("patient_id")
  kind             String   @default("wise_report")
  title            String
  /// The report's markdown with its <chart>/<table>/<sections> blocks.
  body             String
  /// The embedded tool results by result id, as they were when saved.
  data             Json
  version          Int
  sourceChatId     String   @map("source_chat_id")
  sourceToolCallId String   @unique(map: "clinical_document_source_tool_call_id_unique") @map("source_tool_call_id")
  createdById      String   @map("created_by_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  patient          Patient  @relation(fields: [patientId], references: [id], onUpdate: NoAction, map: "clinical_document_patient_id_patient_id_fk")
  createdBy        User     @relation(fields: [createdById], references: [id], onUpdate: NoAction, map: "clinical_document_created_by_id_user_id_fk")

  @@index([patientId, createdAt], map: "clinical_document_patientId_createdAt_idx")
  @@map("clinical_document")
}
