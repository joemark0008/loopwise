// Postgres enums shared by the clinical models (DESIGN.md §5).

enum OrganizationType {
  clinic
  lab
  imaging
  hospital
  pharmacy
  program

  @@map("organization_type")
}

enum Sex {
  female
  male
  other
  unknown

  @@map("sex")
}

enum CareRelationshipReason {
  encounter
  order
  referral
  case_owner
  break_glass

  @@map("care_relationship_reason")
}

enum OrderPriority {
  routine
  urgent
  stat

  @@map("order_priority")
}

enum OrderStatus {
  draft
  sent
  accepted
  collected
  resulted
  reviewed
  cancelled
  /// The target facility refused the order (`status_reason` says why).
  rejected

  @@map("order_status")
}

enum ResultFlag {
  normal
  low
  high
  abnormal
  critical_low
  critical_high

  @@map("result_flag")
}

enum CaseState {
  open
  notified
  acknowledged
  confirming
  referred
  accepted
  seen
  treatment_started
  closed
  escalated
  lost_to_follow_up

  @@map("case_state")
}

enum Urgency {
  routine
  soon
  urgent
  critical

  @@map("urgency")
}

enum ActorType {
  user
  organization
  system

  @@map("actor_type")
}

enum ReferralStatus {
  sent
  accepted
  rejected
  booked
  seen
  cancelled

  @@map("referral_status")
}

enum TaskStatus {
  open
  in_progress
  done
  cancelled

  @@map("task_status")
}

enum EvidenceType {
  result
  visit_note
  dispense
  signoff

  @@map("evidence_type")
}

enum MessageChannel {
  sms
  messenger
  secure_link
  phone_call
  home_visit

  @@map("message_channel")
}

enum MessageStatus {
  draft
  queued
  sent
  delivered
  failed
  acknowledged
  replied

  @@map("message_status")
}

enum DiagnosisCertainty {
  provisional
  confirmed

  @@map("diagnosis_certainty")
}

enum AllergyKind {
  drug
  food
  environment
  other

  @@map("allergy_kind")
}

enum AllergySeverity {
  mild
  moderate
  severe

  @@map("allergy_severity")
}

/// A prescription or medical certificate: editable as a draft, immutable once issued (it can only be voided).
enum DocumentStatus {
  draft
  issued
  voided

  @@map("document_status")
}

enum MedicationRoute {
  oral
  sublingual
  topical
  inhalation
  nasal
  ophthalmic
  otic
  rectal
  vaginal
  intramuscular
  intravenous
  subcutaneous
  other

  @@map("medication_route")
}

enum WorkFitness {
  fit_to_work
  fit_with_restrictions
  unfit

  @@map("work_fitness")
}

enum BillStatus {
  draft
  finalized
  paid
  voided

  @@map("bill_status")
}

enum ChargeKind {
  consultation
  procedure
  laboratory
  imaging
  medicine
  supply
  other

  @@map("charge_kind")
}

/// The 20% discounts of RA 9994 (senior citizens) and RA 10754 (persons with disability).
enum BillDiscountKind {
  senior_citizen
  pwd

  @@map("bill_discount_kind")
}

enum Hl7OutboxStatus {
  pending
  delivered
  failed

  @@map("hl7_outbox_status")
}
