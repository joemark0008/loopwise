// =============================================================================
//  IMMUNIZATION — pediatric (DOH EPI / NIP), adult (flu, pneumo), anti-rabies
// =============================================================================

enum VaccineRoute {
  IM
  SC
  ID // intradermal (BCG, ARV ID regimen)
  ORAL
  INTRANASAL

  @@map("vaccine_route")
}

model Immunization {
  id               String         @id @default(uuid(7)) @db.Uuid
  encounterId      String         @map("encounter_id") @db.Uuid
  inventoryItemId  String?        @map("inventory_item_id") @db.Uuid
  inventoryLotId   String?        @map("inventory_lot_id") @db.Uuid
  vaccineName      String         @map("vaccine_name") // "Pentavalent (DPT-HepB-Hib)", "Influenza Quadrivalent"
  antigen          String? // BCG, OPV, IPV, PCV, MMR, HPV, Rabies …
  doseNumber       Int?           @map("dose_number") // 1, 2, 3 …
  doseLabel        String?        @map("dose_label") // "Booster", "Day 7"
  lotNo            String?        @map("lot_no")
  expiryDate       DateTime?      @map("expiry_date") @db.Date
  route            VaccineRoute?
  site             String? // L deltoid, R vastus lateralis
  administeredAt   DateTime       @default(now()) @map("administered_at") @db.Timestamptz(3)
  administeredById String?        @map("administered_by_id") @db.Uuid
  nextDueDate      DateTime?      @map("next_due_date") @db.Date
  isNipVaccine     Boolean        @default(false) @map("is_nip_vaccine") // DOH National Immunization Program
  isHistorical     Boolean        @default(false) @map("is_historical") // recorded from baby book, not given here — logged in the encounter where it was reviewed; administeredAt = original date
  adverseReaction  String?        @map("adverse_reaction")
  remarks          String?
  encounter        Encounter      @relation(fields: [encounterId], references: [id])
  administeredBy   Practitioner?  @relation(fields: [administeredById], references: [id])
  inventoryItem    InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  inventoryLot     InventoryLot?  @relation(fields: [inventoryLotId], references: [id])

  @@index([encounterId])
  @@index([nextDueDate])
  @@map("immunizations")
}
