// How each Wise proposal card ended (DESIGN.md §7.1). One row per tool call: the unique key is what stops a card from
// being confirmed twice, after a reload or from a second tab. Append-only, like the audit log.

/// A Wise proposal card the clinician confirmed or cancelled. Ids are plain columns: the chat can be deleted.
model WiseProposalOutcome {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  chatId     String   @map("chat_id")
  messageId  String   @map("message_id")
  toolCallId String   @unique(map: "wise_proposal_outcome_tool_call_id_unique") @map("tool_call_id")
  toolName   String   @map("tool_name")
  /// `confirmed` or `cancelled`.
  status     String
  resource   String?
  resourceId String?  @map("resource_id")
  /// Whether the clinician changed Wise's draft before confirming.
  edited     Boolean  @default(false)
  at         DateTime @default(now()) @db.Timestamp(6)

  @@index([chatId], map: "wise_proposal_outcome_chat_id_idx")
  @@map("wise_proposal_outcome")
}
