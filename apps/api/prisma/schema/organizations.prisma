// Organizations (tenants), users, projects and their memberships, user groups and preferences.

model OrgMember {
  orgId        String       @map("org_id")
  userId       String       @map("user_id")
  role         String
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "org_member_org_id_organization_id_fk")
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "org_member_user_id_user_id_fk")

  @@id([orgId, userId], map: "org_member_org_id_user_id_pk")
  @@index([userId], map: "org_member_userId_idx")
  @@map("org_member")
}

model Organization {
  id                 String               @id @default(uuid())
  name               String
  slug               String               @unique(map: "organization_slug_unique")
  googleClientId     String?              @map("google_client_id")
  googleClientSecret String?              @map("google_client_secret")
  googleAuthDomains  String?              @map("google_auth_domains")
  /// The kind of facility (DESIGN.md §6.1: each facility is an organization).
  type               OrganizationType     @default(clinic)
  /// For letterheads (prescriptions, medical certificates).
  address            String?
  phone              String?
  /// The facility's lab system takes orders over HL7 through the edge connector; otherwise it uses the worklist.
  usesHl7Connector   Boolean              @default(false) @map("uses_hl7_connector")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  apiKeys            ApiKey[]
  orgMembers         OrgMember[]
  projects           Project[]
  patientIdentifiers PatientIdentifier[]
  careRelationships  CareRelationship[]
  encounters         Encounter[]
  orderedOrders      ClinicalOrder[]      @relation("clinical_order_ordering_org")
  receivedOrders     ClinicalOrder[]      @relation("clinical_order_target_org")
  results            Result[]
  hl7Messages        Hl7Message[]
  ownedCases         CareCase[]
  sentReferrals      Referral[]           @relation("referral_from_org")
  receivedReferrals  Referral[]           @relation("referral_to_org")
  tasks              Task[]
  evidence           Evidence[]
  vitalSigns         VitalSigns[]
  diagnoses          EncounterDiagnosis[]
  allergies          PatientAllergy[]
  prescriptions      Prescription[]
  certificates       MedicalCertificate[]
  bills              EncounterBill[]
  hl7Outbox          Hl7Outbox[]

  @@map("organization")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Project {
  id                  String               @id @default(uuid())
  name                String
  type                String
  path                String?
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  orgId               String?              @map("org_id")
  agentSettings       Json?                @map("agent_settings")
  envVars             Json                 @default("{}") @map("env_vars")
  displaySettings     Json?                @map("display_settings")
  mapSettings         Json?                @map("map_settings")
  defaultModels       Json?                @map("default_models")
  activities          Activity[]
  analyticsEvents     AnalyticsEvent[]
  automations         Automation[]
  chats               Chat[]
  llmInferences       LlmInference[]
  logs                Log[]
  notifications       Notification[]
  organization        Organization?        @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "project_org_id_organization_id_fk")
  projectLlmConfigs   ProjectLlmConfig[]
  projectMembers      ProjectMember[]
  projectSavedPrompts ProjectSavedPrompt[]
  userGroups          UserGroup[]

  @@index([orgId], map: "project_orgId_idx")
  @@map("project")
}

model ProjectLlmConfig {
  id            String   @id @default(uuid())
  projectId     String   @map("project_id")
  provider      String
  apiKey        String   @map("api_key")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  enabledModels Json     @default("[]") @map("enabled_models")
  baseUrl       String?  @map("base_url")
  credentials   Json?
  customModels  Json     @default("[]") @map("custom_models")
  modelSettings Json     @default("{}") @map("model_settings")
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "project_llm_config_project_id_project_id_fk")

  @@unique([projectId, provider], map: "project_llm_config_project_provider")
  @@index([projectId], map: "project_llm_config_projectId_idx")
  @@map("project_llm_config")
}

model ProjectMember {
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  role      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "project_member_project_id_project_id_fk")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "project_member_user_id_user_id_fk")

  @@id([projectId, userId], map: "project_member_project_id_user_id_pk")
  @@index([userId], map: "project_member_userId_idx")
  @@map("project_member")
}

model ProjectSavedPrompt {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  title     String
  prompt    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "project_saved_prompt_project_id_project_id_fk")

  @@index([projectId], map: "project_saved_prompt_projectId_idx")
  @@map("project_saved_prompt")
}

model User {
  id                       String                    @id @default(uuid())
  name                     String
  email                    String                    @unique(map: "user_email_unique")
  emailVerified            Boolean                   @default(false) @map("email_verified")
  image                    String?
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  requiresPasswordReset    Boolean                   @default(false) @map("requires_password_reset")
  memoryEnabled            Boolean                   @default(true) @map("memory_enabled")
  messagingProviderCode    String?                   @unique(map: "user_messaging_provider_code_unique") @map("messaging_provider_code")
  githubAccessToken        String?                   @map("github_access_token")
  gitlabAccessToken        String?                   @map("gitlab_access_token")
  deactivatedAt            DateTime?                 @map("deactivated_at") @db.Timestamp(6)
  accounts                 Account[]
  activities               Activity[]
  analyticsEvents          AnalyticsEvent[]
  apiKeys                  ApiKey[]
  automations              Automation[]
  chats                    Chat[]
  chatMessages             ChatMessage[]
  llmInferences            LlmInference[]
  memories                 Memory[]
  notifications            Notification[]
  notificationUnsubscribes NotificationUnsubscribe[]
  oauthAccessTokens        OauthAccessToken[]
  oauthClients             OauthClient[]
  oauthConsents            OauthConsent[]
  oauthRefreshTokens       OauthRefreshToken[]
  orgMembers               OrgMember[]
  projectMembers           ProjectMember[]
  sessions                 Session[]
  sharedChatAccess         SharedChatAccess[]
  userGroupMembers         UserGroupMember[]
  userPreference           UserPreference?

  careRelationships CareRelationship[]
  encounters        Encounter[]
  orders            ClinicalOrder[]
  reviewedResults   Result[]
  ownedCases        CareCase[]
  receivedReferrals Referral[]
  tasks             Task[]
  recordedEvidence  Evidence[]
  patientMessages   PatientMessage[]
  recordedVitals    VitalSigns[]
  recordedDiagnoses EncounterDiagnosis[]
  recordedAllergies PatientAllergy[]
  clinicalDocuments ClinicalDocument[]
  prescriptions     Prescription[]
  certificates      MedicalCertificate[]
  clinicianProfile  ClinicianProfile?

  @@map("user")
}

model UserGroup {
  id               String            @id @default(uuid())
  projectId        String            @map("project_id")
  name             String
  isDefault        Boolean           @default(false) @map("is_default")
  featureGrants    Json              @default("{\"version\": 2, \"features\": [], \"toolCallDensity\": {\"canChange\": true, \"defaultDensity\": \"detailed\"}}") @map("feature_grants")
  contextGrants    Json?             @map("context_grants")
  rowPolicies      Json?             @map("row_policies")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_group_project_id_project_id_fk")
  userGroupMembers UserGroupMember[]

  @@unique([projectId], map: "user_group_project_default_unique", where: raw("(is_default = true)"))
  @@unique([projectId, name], map: "user_group_project_name_unique")
  @@index([projectId], map: "user_group_projectId_idx")
  @@map("user_group")
}

model UserGroupMember {
  groupId   String    @map("group_id")
  userId    String    @map("user_id")
  provider  String    @default("manual")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  userGroup UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_group_member_group_id_user_group_id_fk")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_group_member_user_id_user_id_fk")

  @@id([groupId, userId, provider], map: "user_group_member_group_id_user_id_provider_pk")
  @@index([userId, provider], map: "user_group_member_user_provider_idx")
  @@map("user_group_member")
}

model UserPreference {
  userId      String   @id @map("user_id")
  preferences Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_preference_user_id_user_id_fk")

  @@map("user_preference")
}
