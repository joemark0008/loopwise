// =============================================================================
//  INVENTORY — clinic pharmacy, vaccines, medical supplies, lab reagents
//  - FDA Certificate of Product Registration (CPR) per drug
//  - Lot + expiry tracking (FEFO dispensing)
//  - Dangerous drugs flagged for PDEA/DDB logbook reporting
// =============================================================================

enum ItemCategory {
  MEDICINE
  VACCINE
  MEDICAL_SUPPLY
  LAB_REAGENT
  DENTAL_SUPPLY
  OFFICE_SUPPLY
  OTHER

  @@map("item_category")
}

enum StockMovementType {
  RECEIPT
  DISPENSE // sold / dispensed to patient
  CONSUMPTION // used during procedure / lab
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN_TO_SUPPLIER
  RETURN_FROM_PATIENT
  EXPIRED_DISPOSAL
  DAMAGED

  @@map("stock_movement_type")
}

model InventoryItem {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  sku            String
  barcode        String?
  name           String // display name, e.g. "Amoxicillin 500mg cap (Amoxil)"
  category       ItemCategory

  // Drug fields (null for non-drugs)
  genericName      String? @map("generic_name")
  brandName        String? @map("brand_name")
  strength         String?
  dosageForm       String? @map("dosage_form")
  manufacturer     String?
  fdaCprNo         String? @map("fda_cpr_no") // FDA Certificate of Product Registration
  isRxOnly         Boolean @default(false) @map("is_rx_only")
  isDangerousDrug  Boolean @default(false) @map("is_dangerous_drug") // RA 9165 — S2 required
  isAntimicrobial  Boolean @default(false) @map("is_antimicrobial") // for AMR stewardship reporting
  isPnf            Boolean @default(false) @map("is_pnf") // listed in Philippine National Formulary
  storageCondition String? @map("storage_condition") // "2–8°C", "Store below 30°C"

  unitOfMeasure String   @map("unit_of_measure") // tab, cap, vial, bottle, pc
  packSize      Int?     @map("pack_size") // units per box
  taxType       TaxType  @default(VATABLE) @map("tax_type") // some maintenance meds are VAT-exempt
  defaultCost   Decimal? @map("default_cost") @db.Decimal(12, 2)
  sellingPrice  Decimal? @map("selling_price") @db.Decimal(12, 2)
  reorderLevel  Decimal? @map("reorder_level") @db.Decimal(10, 2)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization      Organization       @relation(fields: [organizationId], references: [id])
  serviceItem       ServiceItem?
  lots              InventoryLot[]
  movements         StockMovement[]
  receiptItems      StockReceiptItem[]
  prescriptionItems PrescriptionItem[]
  immunizations     Immunization[]

  @@unique([organizationId, sku])
  @@index([genericName])
  @@map("inventory_items")
}

model Supplier {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String
  tin            String?
  address        String?
  contactPerson  String? @map("contact_person")
  contactNo      String? @map("contact_no")
  email          String?
  fdaLtoNo       String? @map("fda_lto_no") // FDA License to Operate (drug distributor)
  isActive       Boolean @default(true) @map("is_active")

  organization Organization   @relation(fields: [organizationId], references: [id])
  lots         InventoryLot[]
  receipts     StockReceipt[]

  @@map("suppliers")
}

/// Stock on hand per lot per clinic
model InventoryLot {
  id             String    @id @default(uuid(7)) @db.Uuid
  itemId         String    @map("item_id") @db.Uuid
  clinicId       String    @map("clinic_id") @db.Uuid
  supplierId     String?   @map("supplier_id") @db.Uuid
  lotNo          String    @map("lot_no")
  expiryDate     DateTime? @map("expiry_date") @db.Date
  quantityOnHand Decimal   @default(0) @map("quantity_on_hand") @db.Decimal(12, 2)
  unitCost       Decimal?  @map("unit_cost") @db.Decimal(12, 2)
  receivedAt     DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)

  item          InventoryItem      @relation(fields: [itemId], references: [id])
  clinic        Clinic             @relation(fields: [clinicId], references: [id])
  supplier      Supplier?          @relation(fields: [supplierId], references: [id])
  movements     StockMovement[]
  receiptItems  StockReceiptItem[]
  immunizations Immunization[]

  @@unique([itemId, clinicId, lotNo])
  @@index([clinicId, expiryDate])
  @@map("inventory_lots")
}

/// Immutable stock ledger. quantity is signed (+in / -out).
model StockMovement {
  id                 String            @id @default(uuid(7)) @db.Uuid
  clinicId           String            @map("clinic_id") @db.Uuid
  itemId             String            @map("item_id") @db.Uuid
  lotId              String?           @map("lot_id") @db.Uuid
  type               StockMovementType
  quantity           Decimal           @db.Decimal(12, 2)
  unitCost           Decimal?          @map("unit_cost") @db.Decimal(12, 2)
  balanceAfter       Decimal?          @map("balance_after") @db.Decimal(12, 2)
  encounterId        String?           @map("encounter_id") @db.Uuid
  invoiceLineId      String?           @map("invoice_line_id") @db.Uuid
  prescriptionItemId String?           @map("prescription_item_id") @db.Uuid
  stockReceiptId     String?           @map("stock_receipt_id") @db.Uuid
  transferRef        String?           @map("transfer_ref") // pairs TRANSFER_OUT / TRANSFER_IN
  reason             String?
  performedById      String?           @map("performed_by_id") @db.Uuid
  performedAt        DateTime          @default(now()) @map("performed_at") @db.Timestamptz(3)

  clinic           Clinic            @relation(fields: [clinicId], references: [id])
  item             InventoryItem     @relation(fields: [itemId], references: [id])
  lot              InventoryLot?     @relation(fields: [lotId], references: [id])
  encounter        Encounter?        @relation(fields: [encounterId], references: [id])
  invoiceLine      InvoiceLine?      @relation(fields: [invoiceLineId], references: [id])
  prescriptionItem PrescriptionItem? @relation(fields: [prescriptionItemId], references: [id])
  stockReceipt     StockReceipt?     @relation(fields: [stockReceiptId], references: [id])

  @@index([clinicId, itemId, performedAt])
  @@index([lotId])
  @@map("stock_movements")
}

/// Delivery from supplier (DR / supplier invoice)
model StockReceipt {
  id                String   @id @default(uuid(7)) @db.Uuid
  clinicId          String   @map("clinic_id") @db.Uuid
  supplierId        String   @map("supplier_id") @db.Uuid
  receiptNo         String   @map("receipt_no")
  deliveryReceiptNo String?  @map("delivery_receipt_no")
  supplierInvoiceNo String?  @map("supplier_invoice_no")
  receivedAt        DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  receivedById      String?  @map("received_by_id") @db.Uuid
  totalCost         Decimal  @default(0) @map("total_cost") @db.Decimal(12, 2)
  remarks           String?

  clinic    Clinic             @relation(fields: [clinicId], references: [id])
  supplier  Supplier           @relation(fields: [supplierId], references: [id])
  items     StockReceiptItem[]
  movements StockMovement[]

  @@unique([clinicId, receiptNo])
  @@map("stock_receipts")
}

model StockReceiptItem {
  id         String    @id @default(uuid(7)) @db.Uuid
  receiptId  String    @map("receipt_id") @db.Uuid
  itemId     String    @map("item_id") @db.Uuid
  lotId      String?   @map("lot_id") @db.Uuid
  lotNo      String    @map("lot_no")
  expiryDate DateTime? @map("expiry_date") @db.Date
  quantity   Decimal   @db.Decimal(12, 2)
  unitCost   Decimal   @map("unit_cost") @db.Decimal(12, 2)

  receipt StockReceipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  item    InventoryItem @relation(fields: [itemId], references: [id])
  lot     InventoryLot? @relation(fields: [lotId], references: [id])

  @@map("stock_receipt_items")
}
