		"send-mllp": "node --disable-warning=ExperimentalWarning scripts/send-mllp.ts",
		"test": "vitest run",
		"lint": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"vitest": "^4.0.18"
	}
}
