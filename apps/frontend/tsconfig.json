{
	"include": ["**/*.ts", "**/*.tsx", "eslint.config.js", "vite.config.js"],
	"compilerOptions": {
		"target": "ES2022",
		"jsx": "react-jsx",
		"module": "ESNext",
		"lib": ["ES2022", "ES2024.String", "DOM", "DOM.Iterable"],
		"types": ["vite/client", "bun-types"],
		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": false,
		"noEmit": true,
		/* Linting */
		"skipLibCheck": true,
		"strict": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true,
		/* apps/api sources reached through @loopwise/api/* use Nest decorators */
		"experimentalDecorators": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
			"@loopwise/shared": ["../shared/src/index.ts"],
			"@loopwise/shared/*": ["../shared/src/*"],
			// apps/api's types, and its few pure modules the frontend shares (vite.config.ts aliases them too).
			"@loopwise/api/*": ["../api/src/*"],
			"zod": ["../../node_modules/zod"],
			"zod/*": ["../../node_modules/zod/*"],
			"ai": ["../../node_modules/ai"],
			// 6.3.0 declarations import its .ts sources, which fail strict checks; see the shim.
			"@maplibre/geojson-vt": ["./src/types/maplibre-geojson-vt.d.ts"]
		}
	}
}
