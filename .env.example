# Loopwise settings for local development. Copy to .env (`cp .env.example .env`) and never commit .env.
# Every other setting has a working default; the full list is in apps/api/src/config/env.ts.

# --- Database ---------------------------------------------------------------------------------------------------------
# Used by docker-compose.yml to create the local Postgres container. Postgres applies the user and password only on the
# first start; to change them later run `npm run db:reset` (deletes the dev data).
POSTGRES_USER=loopwise
POSTGRES_PASSWORD=loopwise
POSTGRES_PORT=5435

# How the API connects. It must match the values above, or point at your own Postgres 16.
DATABASE_URL=postgresql://loopwise:loopwise@localhost:5435/loopwise

# --- API --------------------------------------------------------------------------------------------------------------
# The Vite dev server on :3000 sends API calls here.
PORT=5006

# --- Sign-in ----------------------------------------------------------------------------------------------------------
# Signs sessions and derives the /setup token. Generate one with `openssl rand -base64 32`. Optional in development
# (unset: a new one each restart, which signs everyone out); required in production.
BETTER_AUTH_SECRET=
# The URL people open the app at (the Vite dev server in development).
BETTER_AUTH_URL=http://localhost:3000

# --- AI (Wise) --------------------------------------------------------------------------------------------------------
# Optional here: an admin can instead add a provider and key per clinic in Settings → AI and models.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=
# A local model through Ollama:
# OLLAMA_BASE_URL=http://localhost:11434
