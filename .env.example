# Copy to .env and fill in. Never commit .env.

# Docker Postgres (docker-compose.yml). Host port 5435 so it doesn't clash with a local Postgres on 5432.
POSTGRES_USER=loopwise
POSTGRES_PASSWORD=loopwise
POSTGRES_PORT=5435

# App database (Prisma)
DATABASE_URL=postgresql://loopwise:loopwise@localhost:5435/loopwise
# Wise analytics connects as its own read-only role (migration 0015). Optional: defaults to DATABASE_URL with the
# development credentials loopwise_analyst:loopwise_analyst. Set a real password for the role outside development.
# ANALYTICS_DATABASE_URL=postgresql://loopwise_analyst:loopwise_analyst@localhost:5435/loopwise

# apps/api port (the Vite dev server on :3000 proxies the API to it)
PORT=5006

# Auth (better-auth)
# Also produces the setup token the API prints at startup for the /setup wizard.
BETTER_AUTH_SECRET= # run `openssl rand -base64 32` to generate
# Public URL of the app (auth redirects, trusted origins)
BETTER_AUTH_URL=http://localhost:3000

# LLM providers — set at least one
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
# OPENAI_COMPATIBLE_API_KEY=

# apps/api: GitHub owner/name whose releases the update check compares against (unset: no update check)
# LOOPWISE_RELEASES_REPOSITORY=
# apps/api: default local project (context files) created for the first user
# LOOPWISE_DEFAULT_PROJECT_PATH=
# apps/api: where project folders (context files) and stored files live
# LOOPWISE_PROJECTS_DIR=./projects
# LOOPWISE_STORAGE_LOCAL_PATH=./storage
# apps/api: directory with eng.traineddata.gz and fil.traineddata.gz for OCR of scanned PDFs
# (unset: the copies bundled with @tesseract.js-data/eng and /fil; nothing is downloaded)
# OCR_LANG_PATH=
# apps/api: off keeps skills file-only, with no saving from the app or chat
# LOOPWISE_SKILL_AUTHORING=auto
# apps/api: built frontend to serve (the Docker image sets it; leave unset with the Vite dev server)
# LOOPWISE_FRONTEND_DIST=../frontend/dist

# Frontend links (build time). Unset: the UI that would link there is hidden.
# VITE_LOOPWISE_DOCS_URL=
# VITE_LOOPWISE_SUPPORT_EMAIL=
# VITE_LOOPWISE_REPOSITORY_URL=
# VITE_LOOPWISE_COMMUNITY_URL=
# VITE_LOOPWISE_NEWSLETTER_SUBSCRIBE_URL=
# VITE_LOOPWISE_PRIVACY_URL=

# HL7 ingest (POST /api/hl7/messages, Authorization: Bearer <facility key>). DEV ONLY: the seed creates this
# synthetic key for the bohol-diagnostics lab; scripts/send-hl7-sample.sh and the edge connector use it locally.
# Production keys are issued by an org admin with the createFacilityKey mutation and shown once.
# LOOPWISE_FACILITY_KEY=lw_dev_bohol_diagnostics_synthetic_key_0001
